# Runtime
MARKER_ENV=development
MARKER_HOST=127.0.0.1
MARKER_PORT=8000
MARKER_DATA_DIR=./data
MARKER_FIXTURES_DIR=./fixtures/demo
MARKER_DATABASE_URL=sqlite:///./data/db/marker.sqlite3
MARKER_WORKER_CONCURRENCY=3
MARKER_FRONTEND_DIR=./frontend
MARKER_LLM=university
MARKER_USE_MOCKS=false
MARKER_TIMEZONE=Australia/Sydney

# Worker
MARKER_WORKER_ID=local-worker-1
MARKER_JOB_LEASE_SECONDS=60
MARKER_JOB_MAX_ATTEMPTS=3

# University/OpenAI-compatible provider (leave secrets blank)
MARKER_AI_BASE_URL=
MARKER_AI_API_KEY=
MARKER_AI_MODEL=gpt-4.1
MARKER_AI_TIMEOUT_SECONDS=120
# Provider calls in flight across all worker slots; retries for 429/5xx/timeouts (Retry-After honoured)
MARKER_LLM_MAX_IN_FLIGHT=6
MARKER_LLM_MAX_RETRIES=5
MARKER_LLM_MAX_BACKOFF_SECONDS=60
# Criteria of one submission graded at the same time
MARKER_CRITERION_CONCURRENCY=3

# What the evidence step reads (too long for the model → manual marking, never truncated):
#   full_tools = the whole submission, quotes verified as they are cited, search before "missing" (default)
#   full       = the whole submission in one call
#   retrieval  = per-criterion retrieved passages (evaluation comparison only)
MARKER_GRADING_CONTEXT=full_tools
MARKER_AGENT_MAX_ROUNDS=4
MARKER_AI_CONTEXT_TOKENS=128000

# Local hybrid vector retrieval (used when MARKER_GRADING_CONTEXT=retrieval)
MARKER_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MARKER_EMBEDDING_THREADS=2
MARKER_RETRIEVAL_CANDIDATE_LIMIT=12
MARKER_EVIDENCE_TOP_K=5

# External-provider keys (optional; local-real only)
MARKER_AZURE_API_KEY=
MARKER_MINIMAX_API_KEY=
MARKER_OPENAI_API_KEY=
MARKER_ANTHROPIC_API_KEY=

